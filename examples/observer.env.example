# Copy to .env and replace paths and numeric IDs for your VPS.
# DATADIR means the network's chain directory containing .cookie/debug.log.
TESTNET4_DATADIR=/var/lib/bitcoin/testnet4
SIGNET_DATADIR=/var/lib/bitcoin/signet
TESTNET4_LAB_DATA=/var/lib/staletip-lab/testnet4
SIGNET_LAB_DATA=/var/lib/staletip-lab/signet
TESTNET4_UID=1000
TESTNET4_GID=1000
SIGNET_UID=1000
SIGNET_GID=1000

# Optional compose.relay-test.yaml setup. Set A's reachable P2P endpoint in .env.
# The documentation address below is a placeholder; replace it before enabling.
# TESTNET4_RELAY_PEER=192.0.2.10:48333
# TESTNET4_RELAY_DATA is B's root datadir, not A's chain directory.
# Create it with the same TESTNET4_UID/GID used by the observer.
TESTNET4_RELAY_DATA=./relay-peer-data
TESTNET4_RELAY_OBSERVER_CONFIG=./examples/observer-testnet4-relay.json
BITCOIN_REVISION=073a114dde430cc783564b35cae4e232e8a6aeb4
BITCOIN_BUILD_JOBS=2
